from "./MailFact.cpx" import { MailFact }
from "./MailButton.cpx" import { MailButton }

// HTML e-mail with inline styles (mail clients ignore style sheets). The doctype is prepended by PHP.
export component Mail {
  salonName: string
  accent: string
  preheader: string
  heading: string
  intro: slot
  facts: list<MailFact>
  note: slot
  buttons: list<MailButton>
  footer: string

  render <html lang="de">
    <head>
      <meta charset="UTF-8"/>
      <meta name="viewport" content="width=device-width, initial-scale=1"/>
      <title>{heading}</title>
    </head>
    <body style="margin:0;padding:0;background:#f4f1ee;font-family:Helvetica,Arial,sans-serif;color:#222222;">
      <div style="display:none;max-height:0;overflow:hidden;">{preheader}</div>
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f4f1ee;padding:24px 12px;">
        <tr>
          <td align="center">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:600px;background:#ffffff;border-radius:8px;">
              <tr>
                <td style="background:{accent};color:#ffffff;padding:22px 32px;font-size:20px;font-weight:bold;border-radius:8px 8px 0 0;">{salonName}</td>
              </tr>
              <tr>
                <td style="padding:32px;">
                  <h1 style="margin:0 0 16px;font-size:22px;line-height:1.3;color:#222222;">{heading}</h1>
                  <div style="font-size:16px;line-height:1.6;">{intro}</div>
                  {facts.count > 0
                    ? <table role="presentation" cellpadding="0" cellspacing="0" style="margin:20px 0;border-top:1px solid #eeeeee;border-bottom:1px solid #eeeeee;width:100%;">{facts}</table>
                    : null}
                  <div style="font-size:16px;line-height:1.6;">{note}</div>
                  {buttons.count > 0 ? <div style="margin-top:24px;">{buttons}</div> : null}
                </td>
              </tr>
              <tr>
                <td style="padding:18px 32px;background:#faf8f6;color:#777777;font-size:13px;line-height:1.5;border-radius:0 0 8px 8px;">{footer}</td>
              </tr>
            </table>
          </td>
        </tr>
      </table>
    </body>
  </html>
}
