from "./Csrf.cpx" import { Csrf }

export component NoteForm {
  action: string
  csrf: string
  note: string

  render <form class="ff-panel ff-form" method="post" action={action}>
    <Csrf token={csrf}/>
    <h3 class="ff-panel__title">Interne Notiz</h3>
    <p class="ff-muted">Nur im Backend sichtbar.</p>
    <textarea name="moduleArguments[note]" rows="3">{note}</textarea>
    <button class="neos-button" type="submit">Notiz speichern</button>
  </form>
}
