from "./SlideItem.cpx" import { SlideItem }
from "../Atom/Icon.cpx" import { Icon }
from "../Data/IconName.cpx" import { IconName }

// Scroll-snap carousel: swipeable without JS, main.js adds the previous/next buttons behaviour
export component Slider {
  title: slot
  slides: list<SlideItem>

  render <div class="slider" data-slider>
    <header class="slider__head">
      <h2 class="section-head__title">{title}</h2>
      {slides.count > 1
        ? <div class="slider__controls">
            <button class="slider__button slider__button--prev" type="button" data-slider-prev aria-label="Vorheriges Bild"><Icon name={IconName.ARROW}/></button>
            <button class="slider__button" type="button" data-slider-next aria-label="Nächstes Bild"><Icon name={IconName.ARROW}/></button>
          </div>
        : null}
    </header>
    {slides.count > 0 ? <div class="slider__track" data-slider-track>{slides}</div> : <p class="empty-hint">Bitte im Inspector Fotos auswählen.</p>}
  </div>
}
